# ==============================================================================
# Progress Overload & Nutrition Workout App - Environment Configuration
# ==============================================================================

# Database Configuration
DATABASE_URL=sqlite:///./workout_app.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://workout_user:workout_secure_password@postgres:5432/workout_app

# Ollama LLM Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=45

# SparkyFitness Service Configuration
SPARKY_BASE_URL=http://localhost:8080
SPARKY_API_TOKEN=your_sparky_api_token_here
SPARKY_TIMEOUT_SECONDS=15
